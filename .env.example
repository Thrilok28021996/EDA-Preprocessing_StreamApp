# =============================================================================
# ENVIRONMENT CONFIGURATION FILE
# =============================================================================
# This file contains all required environment variables for the Django EDA app.
# Copy this file to .env and update with your actual values.
# NEVER commit the .env file to version control!
#
# SECURITY NOTE: All sensitive values must be changed from these defaults.
# =============================================================================

# =============================================================================
# CRITICAL SECURITY SETTINGS (MUST CHANGE IN PRODUCTION)
# =============================================================================

# SECURITY FIX #1: Django Secret Key
# Generate a new secret key using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-IN-PRODUCTION

# SECURITY FIX #2: Debug Mode (MUST be False in production)
DEBUG=False

# SECURITY FIX #3: Allowed Hosts (comma-separated list of domains)
# Example: ALLOWED_HOSTS=example.com,www.example.com,api.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database URL (for production)
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://eda_user:secure-password-here@localhost:5432/eda_database

# SQLite (for development only)
# Leave DATABASE_URL empty to use SQLite

# PostgreSQL Direct Configuration (alternative to DATABASE_URL)
POSTGRES_DB=eda_database
POSTGRES_USER=eda_user
POSTGRES_PASSWORD=secure-password-here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# SECURITY SETTINGS (HTTPS/SSL)
# =============================================================================

# SECURITY FIX #11: HTTPS enforcement
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_SAMESITE=Lax

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================

# SECURITY FIX #8: File upload limits (in bytes)
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760  # 10MB
MAX_DATAFRAME_SIZE_MB=100

# =============================================================================
# SESSION SETTINGS
# =============================================================================

# SECURITY FIX #16: Session security
SESSION_COOKIE_AGE=3600  # 1 hour (reduced for security)
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_EXPIRE_AT_BROWSER_CLOSE=False

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

LOG_LEVEL=INFO
LOG_DIR=/var/log/eda_app

# =============================================================================
# RATE LIMITING
# =============================================================================

# SECURITY FIX #10: Rate limiting settings
RATE_LIMIT_FILE_UPLOAD=10  # uploads per hour
RATE_LIMIT_API_CALLS=100  # API calls per hour
RATE_LIMIT_FEEDBACK=5  # feedback submissions per 5 minutes

# =============================================================================
# CORS SETTINGS (for API access)
# =============================================================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# =============================================================================
# MONITORING & ERROR TRACKING
# =============================================================================

# Sentry DSN (optional - for error tracking)
SENTRY_DSN=

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Set to True only in development
ENABLE_DEBUG_TOOLBAR=False
ENABLE_PERFORMANCE_MONITORING=True